# =========================================
# Environment Variables - TEMPLATE
# =========================================
# Copy this file to .env and fill in with your actual values
# NEVER commit .env to version control

# =========================================
# Database Configuration
# =========================================
DB_URL=jdbc:postgresql://postgres:5432/managmentSystemSchool
DB_USERNAME=postgres
DB_PASSWORD=change_me_in_production

# =========================================
# JWT Security
# =========================================
# Generate a strong random string (at least 32 characters)
# You can generate with: openssl rand -base64 32
JWT_SECRET=your_very_secure_jwt_secret_here_change_in_production

# =========================================
# OAuth2 Google Configuration
# Get these from: https://console.cloud.google.com/
# =========================================
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
OAUTH2_REDIRECT_URL=http://localhost:5173/oauth2/redirect

# =========================================
# Server Configuration
# =========================================
PORT=8080

# =========================================
# Production URLs (update these for production)
# =========================================
# For development:
# OAUTH2_REDIRECT_URL=http://localhost:5173/oauth2/redirect
# For production (example):
# OAUTH2_REDIRECT_URL=https://yourdomain.com/oauth2/redirect

